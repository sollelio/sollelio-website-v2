{
  "name": "sollelio-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check && astro build && node scripts/finalise-csp.mjs",
    "preview": "astro preview",
    "check": "node scripts/require-checker.mjs && astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "build:og": "node scripts/build-og.mjs",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "verify": "npm run format:check && npm run lint && npm run check:contrast && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
