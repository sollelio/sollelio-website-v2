---
import Base from '../../layouts/Base.astro';
import { privacy } from '../../content/pages/privacy.ts';
import type { Locale } from '../../i18n/routes.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = privacy[locale];
---

<Base
  locale={locale}
  route="privacy"
  product="company"
  title={c.meta.title}
  description={c.meta.description}
>
  <section class="container pt-14 pb-16 md:pt-24 md:pb-24">
    <div class="max-w-[72ch]">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="display mt-6">{c.title}</h1>
      <p
        class="mt-8 rounded-card border border-line bg-bg-3 px-5 py-4 text-[0.9375rem] font-semibold"
        role="note"
      >
        {c.notice}
      </p>
      <div class="mt-12 flex flex-col gap-10">
        {c.sections.map((section) => (
          <section>
            <h2 class="h3">{section.title}</h2>
            <div class="prose-site mt-3 text-ink-2">
              {section.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
              {section.list && (
                <ul class="mt-3 list-disc pl-5">
                  {section.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
          </section>
        ))}
      </div>
      <p class="mono mt-12 text-ink-3">{c.updated}</p>
    </div>
  </section>
</Base>
