---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { pathFor, type Locale, type RouteId } from '../../i18n/routes.ts';
import { useTranslations } from '../../i18n/ui.ts';
import { contactEmail } from '../../config/site.ts';

interface Props {
  locale: Locale;
  route?: RouteId;
}
const { locale, route } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line">
  <div class="container grid gap-10 py-14 md:grid-cols-[1.6fr_1fr_1fr_1fr] md:gap-8">
    <div class="flex flex-col gap-5">
      <Logo
        href={pathFor('home', locale)}
        label={`${t('site.name')} — ${t('nav.home')}`}
        variant="lockup"
      />
      <p class="max-w-[30ch] text-[0.9375rem] text-ink-2">{t('site.line')}</p>
    </div>
    <div>
      <h2 class="mono mb-4 text-ink-3">{t('footer.products')}</h2>
      <ul class="flex flex-col gap-2.5 text-[0.9375rem]">
        <li>
          <a href={pathFor('events', locale)} class="text-ink no-underline hover:underline">
            Sollelio Events
          </a>
        </li>
        <li>
          <a href={pathFor('beauty', locale)} class="text-ink no-underline hover:underline">
            Sollelio Beauty OS
          </a>
        </li>
      </ul>
    </div>
    <div>
      <h2 class="mono mb-4 text-ink-3">{t('footer.programme')}</h2>
      <ul class="flex flex-col gap-2.5 text-[0.9375rem]">
        <li>
          <a href={pathFor('partners', locale)} class="text-ink no-underline hover:underline">
            {t('nav.partners')}
          </a>
        </li>
        <li>
          <a
            href={`${pathFor('partners', locale)}#faq`}
            class="text-ink no-underline hover:underline"
          >
            {t('footer.faq')}
          </a>
        </li>
      </ul>
    </div>
    <div>
      <h2 class="mono mb-4 text-ink-3">{t('footer.company')}</h2>
      <ul class="flex flex-col gap-2.5 text-[0.9375rem]">
        <li>
          <a href={`mailto:${contactEmail}`} class="text-ink no-underline hover:underline">
            {contactEmail}
          </a>
        </li>
        <li>
          <a href={pathFor('privacy', locale)} class="text-ink no-underline hover:underline">
            {t('footer.privacy')}
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="container">
    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line py-6 text-sm text-ink-3">
      <p>
        © {year} Sollelio · {t('footer.country')}. {t('footer.rights')}
      </p>
      <div class="flex items-center gap-2">
        <LangSwitch locale={locale} route={route} />
        <ThemeToggle locale={locale} />
      </div>
    </div>
  </div>
</footer>
