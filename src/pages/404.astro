---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { useTranslations } from '../i18n/ui.ts';
import { pathFor } from '../i18n/routes.ts';

const t = useTranslations('pt-PT');
const en = useTranslations('en');
---

<Base
  locale="pt-PT"
  title={`${t('notfound.title')} — Sollelio`}
  description={t('notfound.body')}
  noindex
>
  <section class="container py-20 md:py-32">
    <p class="eyebrow">404</p>
    <h1 class="display mt-5">{t('notfound.title')}</h1>
    <p class="lead mt-6 max-w-[56ch]">{t('notfound.body')}</p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button href={pathFor('home', 'pt-PT')} arrow>
        {t('notfound.back')}
      </Button>
      <a href={pathFor('home', 'en')} lang="en" hreflang="en" class="btn btn-link">
        {en('notfound.back')} (English)
      </a>
    </div>
  </section>
</Base>
